{
  "name": "@mcp-registry/desktop",
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build:electron": "vite build --config vite.electron.config.ts",
    "build:web": "vite build",
    "build": "tsc -p tsconfig.json && pnpm run build:electron && pnpm run build:web",
    "package:win": "pnpm run build && node scripts/package-win.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mcp-registry/core": "workspace:*",
    "@mcp-registry/shared": "workspace:*",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "vite": "^5.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.7.0"
  }
}
